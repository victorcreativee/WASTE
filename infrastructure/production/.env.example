POSTGRES_DB=kampala_wms
POSTGRES_USER=kampala_wms
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET

WMS_WEB_PORT=127.0.0.1:8082
WMS_GATEWAY_PORT=127.0.0.1:8095

# Optional. Which proxies Express trusts for the client IP (rate limits, audit).
# Default trusts loopback and private networks (nginx on the host + Docker network).
# Passed to the Node services by compose.yaml. Set to the number of proxy hops (e.g. 2) if a public CDN/load balancer sits in front.
# TRUST_PROXY=loopback, linklocal, uniquelocal
# Public web address printed in permit certificate QR codes, e.g. https://wms.kcca.go.ug
PUBLIC_APP_URL=
# Browser origins allowed to call the API (comma-separated). Usually the same as PUBLIC_APP_URL. Empty = allow any.
CORS_ORIGINS=
