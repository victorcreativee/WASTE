POSTGRES_DB=kampala_wms
POSTGRES_USER=kampala_wms
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET

WMS_WEB_PORT=127.0.0.1:8082
WMS_GATEWAY_PORT=127.0.0.1:8095

# Optional. Which proxies Express trusts for the client IP (rate limits, audit).
# Default trusts loopback and private networks (nginx on the host + Docker network).
# Passed to the Node services by compose.yaml. Set to the number of proxy hops (e.g. 2) if a public CDN/load balancer sits in front.
# TRUST_PROXY=loopback, linklocal, uniquelocal
# Database role the services switch to so row-level security applies (migration 113). Leave unset.
# Emergency only: DB_APP_ROLE= (empty) turns tenant isolation off without a migration; the audit log keeps recording.
# DB_APP_ROLE=kwms_app
# Public web address printed in permit certificate QR codes, e.g. https://wms.kcca.go.ug
PUBLIC_APP_URL=
# Browser origins allowed to call the API (comma-separated). Usually the same as PUBLIC_APP_URL. Empty = allow any.
CORS_ORIGINS=

# Required for new-account email verification. Use resend in production: the droplet's SMTP ports are blocked.
# New accounts are created but cannot sign in until delivery works and their one-time link is used.
NOTIFY_EMAIL_PROVIDER=resend
NOTIFY_EMAIL_FROM=Kampala WMS <no-reply@example.com>
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
# Alternative to Resend: set provider=smtp and supply the provider URL.
# SMTP_URL=smtps://USERNAME:PASSWORD@SMTP_HOST:465
# Alternative to SMTP: set provider=webhook and configure these two values.
# NOTIFY_WEBHOOK_URL=https://notifications.example.com/send
# NOTIFY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# Ed25519 key that signs the daily KCCA receipt exports: base64 of 32 random bytes. Keep it secret and never change it
# casually — KCCA verifies exports with the matching public key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RECEIPT_SIGNING_KEY=REPLACE_WITH_RANDOM_KEY

# Encrypts each company's MTN MoMo / Airtel Money credentials: base64 of 32 random bytes. Keep it secret and stable —
# if it changes, every company must enter its credentials again. Generate it the same way as RECEIPT_SIGNING_KEY.
PAYMENT_CREDENTIALS_KEY=REPLACE_WITH_RANDOM_KEY
# Public https address of the API (the gateway), used in MTN MoMo callback URLs, e.g. https://api.example.com.
# Register its host with MTN as the API user's callback host. Without it payments are still confirmed by polling.
PUBLIC_API_URL=
